// -----------------------------------------------------------------------------
// Uniforms
// -----------------------------------------------------------------------------

struct ViewData {
    clip_from_world: mat4x4<f32>,
};

@group(0) @binding(0)
var<uniform> view: ViewData;

struct ModelData {
    model: mat4x4<f32>,
};

@group(0) @binding(1)
var<uniform> model: ModelData;

// -----------------------------------------------------------------------------
// Geometry storage buffer
// -----------------------------------------------------------------------------

struct Vertex {
    position: vec4<f32>,
    normal: vec4<f32>,
};

struct Triangle {
    a: Vertex,
    b: Vertex,
    c: Vertex,
};
//struct Triangle {
//    a: vec3<f32>,
//    b: vec3<f32>,
//    c: vec3<f32>,
//};

@group(1) @binding(0)
var<storage, read> triangles: array<Triangle>;

// -----------------------------------------------------------------------------
// Vertex output
// -----------------------------------------------------------------------------

struct VertexOut {
    @builtin(position) clip_position: vec4<f32>,
};

